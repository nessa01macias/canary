[Unit]
Description=Canary daily capture (perishable sources only)
Documentation=file:/home/deploy/canary/DEPLOY.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/home/deploy/canary/deploy/refresh-runner.sh
WorkingDirectory=/home/deploy/canary/backend

# The fetchers need API keys (Firecrawl, Census, HF) from the backend env file.
EnvironmentFile=-/home/deploy/canary/backend/.env

# NOT CURRENTLY INSTALLED — see the STATUS note in refresh-runner.sh.
#
# This box serves canarylayer.com AND Pharos, a separate live business. The capture
# must always lose to both: low CPU weight, a soft memory ceiling, and a hard cap
# that fails the job rather than inviting the kernel OOM killer to pick a victim
# (which could be the api container, or one of Pharos's). The limits stay tight even
# though the EX44 has 62GB — the point is blast radius, not scarcity.
CPUWeight=20
IOWeight=20
MemoryHigh=512M
MemoryMax=1G
TasksMax=256

# Filesystem containment: it only ever writes the raw archive and its own logs.
ProtectSystem=strict
ReadWritePaths=/home/deploy/canary/backend/data /var/log/canary
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
