# {$SITE_ADDRESS} defaults to :80 so the app works on the bare server IP out of the
# box. Set SITE_ADDRESS=canarylayer.com in the compose env to get automatic HTTPS.
{$SITE_ADDRESS::80} {
	encode gzip zstd

	# API — proxied to the FastAPI container. The frontend calls same-origin /api/*
	# so there's no CORS and no hardcoded backend host. `handle` (not `handle_path`)
	# preserves the /api prefix, which FastAPI mounts its routes under.
	handle /api/* {
		reverse_proxy api:8000
	}

	# Hashed build assets. NO SPA fallback here: a missing asset must 404, never fall
	# through to index.html — HTML returned for a .js/.mjs request is exactly what
	# strict-MIME browsers reject (this is what broke MapLibre's worker -> blank map).
	# Force text/javascript on .mjs so ES-module workers load.
	handle /assets/* {
		@mjs path *.mjs
		header @mjs Content-Type "text/javascript"
		root * /srv
		file_server
	}

	# Everything else is the React SPA. try_files falls back to index.html so
	# client-side routes resolve.
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}
