<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- Canary data ratchet: daily 07:00 local. launchd (unlike cron) runs a missed
       job at next wake if the laptop was asleep/closed at 07:00.
       ENTRY POINT is ~/.local/bin/canary-refresh.sh, NOT the repo script: the repo
       lives under iCloud-synced ~/Documents, and on 2026-07-25 07:07 launchd got a
       dataless placeholder for refresh.sh (exit 127). The launcher (outside iCloud)
       materializes the repo script, then execs it.
       Install:
         cp backend/scripts/refresh-launcher.sh ~/.local/bin/canary-refresh.sh && chmod +x ~/.local/bin/canary-refresh.sh
         cp backend/scripts/com.canary.refresh.plist ~/Library/LaunchAgents/
         launchctl load ~/Library/LaunchAgents/com.canary.refresh.plist
       Verify:  launchctl list | grep canary
       Logs:    backend/data/logs/refresh-YYYY-MM-DD.log -->
  <key>Label</key>
  <string>com.canary.refresh</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/melany.macias/.local/bin/canary-refresh.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>7</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/melany.macias/Documents/Personal/canary/backend/data/logs/launchd.out</string>
  <key>StandardErrorPath</key>
  <string>/Users/melany.macias/Documents/Personal/canary/backend/data/logs/launchd.err</string>
  <key>Nice</key>
  <integer>10</integer>
</dict>
</plist>
