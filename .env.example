# Copy to .env on the server:  cp .env.example .env
#
# Bare IP over HTTP (default) — leave SITE_ADDRESS unset or as :80.
# Real domain with automatic HTTPS — point SITE_ADDRESS at your domain (DNS must
# already resolve to this server's IP, ports 80+443 open).
SITE_ADDRESS=:80

# Client-side MapTiler key (referrer-restricted). Inlined into the JS bundle at
# build time. Leave blank to fall back to the free MapLibre demo tiles.
# This is the ONLY client-side key — it's for the map-tile CDN, not a database.
VITE_MAPTILER_KEY=

# Supabase — SERVER-SIDE ONLY (the api container writes user contributions here).
# Never reaches the browser. Run supabase/schema.sql once before first use.
# SUPABASE_KEY = publishable/anon (enough to INSERT under RLS). Add a service key
# later only if you need server-side reads/aggregation.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_SERVICE_KEY=

# Commute routing — SERVER-SIDE. Powers the "if I lived here…" route lines.
# Provider ladder (see backend/app/api/commute.py):
#   1. STADIA_API_KEY set        → Stadia Maps (Valhalla), all modes. Production.
#      Free dev tier: https://stadiamaps.com
#   2. CANARY_ROUTING=osrm       → keyless public OSRM demo router, DRIVE only.
#   3. neither (default)         → local MOCK: synthetic path + mode-based ETA,
#                                   no network, no key. The map draws out of the box.
STADIA_API_KEY=
# CANARY_ROUTING=osrm

# Local-dev API gate. The data API requires a key (validated against Supabase).
# Set this to run the whole app with NO Supabase and NO key — every request is
# waved through. Leave UNSET in production: the gate then fails closed as designed.
# CANARY_DEV_OPEN_API=1

# LLM keys — SERVER-SIDE, for future request-time endpoints (e.g. /api/explain that
# turns trajectory data into plain English). Optional: leave blank until that
# endpoint exists. Fill in only the provider(s) you actually call from the server.
# (Benchmark/pipeline LLM keys stay in backend/.env on your laptop — different job.)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
